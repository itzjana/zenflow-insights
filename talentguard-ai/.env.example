# ==============================================================================
# TalentGuard AI – Environment Configuration Template
# ==============================================================================

# Backend Configuration (Render / Local)
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# xAI Grok API Key
# Sign up at https://console.x.ai/ to obtain your API key
GROK_API_KEY=your_xai_grok_api_key_here

# Grok Model & Endpoint
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-2-latest

# Responsible AI & Ethical Guardrail Settings
ENFORCE_ETHICAL_GUARDRAILS=true
GUARDRAIL_PROHIBIT_PROTECTED_ATTRS=true
GUARDRAIL_REQUIRE_HUMAN_IN_THE_LOOP=true
GUARDRAIL_MAX_INTERVENTION_BUDGET=10000

# Frontend Configuration (Vercel)
# Set to your deployed Render URL: https://<your-render-app>.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api
