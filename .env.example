# Environment variables for local development.
# Copy to .env and fill in the real values. .env is gitignored — never commit it.

# ── Contact form mail (Zoho Mail) ──
# Zoho is region-sharded and a mailbox only authenticates against its own datacenter.
# Use the host matching the domain you sign in on:
#   zoho.in -> smtp.zoho.in     zoho.com -> smtp.zoho.com     zoho.eu -> smtp.zoho.eu
SMTP_HOST=smtp.zoho.in
# 465 = implicit TLS (recommended). 587 = STARTTLS, if 465 is blocked upstream.
SMTP_PORT=465
# The full mailbox address, which is also the SMTP username.
SMTP_USER=info@zencyp.in
# If two-factor auth is on — and it is by default on Zoho — a normal account password
# is rejected here. Generate an app-specific password and use that instead.
# Always quote it: an unquoted # is read as a comment marker and silently truncates the
# value, which shows up as a 535 auth failure.
SMTP_PASS=""

# Optional. Both default to SMTP_USER. MAIL_FROM must be the authenticated mailbox or
# one of its verified aliases; Zoho rejects anything else.
MAIL_FROM=info@zencyp.in
MAIL_TO=info@zencyp.in
