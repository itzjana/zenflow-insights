# Environment variables for local development.
# Copy to .env and fill in the real values. .env is gitignored — never commit it.

# ── Contact form mail (Hostinger SMTP) ──
# Host and port already default to Hostinger's documented values in code, so in
# practice only SMTP_USER and SMTP_PASS have to be set.
SMTP_HOST=smtp.hostinger.com
# 465 = implicit TLS (recommended). 587 = STARTTLS, if 465 is blocked upstream.
SMTP_PORT=465
# The full mailbox address, which is also the SMTP username.
SMTP_USER=contact@zencyp.in
# The mailbox password — NOT your Hostinger account password.
# Always quote it. An unquoted # is read as a comment marker and silently
# truncates the password, which surfaces as a 535 auth failure.
SMTP_PASS=""

# Optional. Both default to SMTP_USER. MAIL_FROM has to be a mailbox on the
# authenticated domain; Hostinger rejects anything else.
MAIL_FROM=contact@zencyp.in
MAIL_TO=contact@zencyp.in
